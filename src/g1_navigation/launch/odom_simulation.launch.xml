<?xml version="1.0"?>
<launch>
    <arg name="use_sim_time" default="true"/>
    <arg name="network_interface" default="lo" description="Network interface unitree_sdk2 uses to reach unitree_mujoco (its config.yaml interface)"/>
    <arg name="domain_id" default="0" description="DDS domain of unitree_mujoco (its config.yaml domain_id)"/>

    <!-- unitree_mujoco's rt/clock and rt/pose/pelvis -> /clock and /pose/pelvis.
         It is the source of /clock, so it never runs on simulation time. Start
         this launch before a bringup with use_sim_time:=true. -->
    <node pkg="g1_bridge" exec="sim_relay_node" name="sim_relay_node" output="screen">
        <param name="network_interface" value="$(var network_interface)"/>
        <param name="domain_id" value="$(var domain_id)"/>
        <param name="use_sim_time" value="false"/>
    </node>

    <node pkg="g1_navigation" exec="base_footprint_tf_publisher_node"
        name="base_footprint_tf_publisher_node" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <node pkg="tf2_ros" exec="static_transform_publisher" name="base_footprint_to_pelvis"
        args="--x 0 --y 0 --z 0.784202 --roll 0 --pitch 0 --yaw 0 --frame-id base_footprint --child-frame-id pelvis">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <node pkg="tf2_ros" exec="static_transform_publisher" name="mid360_to_livox_frame"
        args="--x 0 --y 0 --z 0 --roll 3.141592653589793 --pitch 0 --yaw 0 --frame-id mid360_link --child-frame-id livox_frame">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- <include file="$(find-pkg-share foxglove_bridge)/launch/foxglove_bridge_launch.xml"/> -->
</launch>
