<?xml version="1.0"?>
<launch>
    <!-- Topics -->
    <arg name="odom_topic"        default="/odom"/>
    <arg name="scan_cloud_topic"  default="/livox/lidar"/>
    <arg name="imu_topic"         default="/livox/imu"/>
    <!-- Frames -->
    <arg name="frame_id"      default="base_footprint"/>
    <arg name="map_frame_id"  default="world"/>
    <arg name="odom_frame_id" default="odom"/>
    <arg name="vo_frame_id"   default="odom"/>
    <arg name="publish_tf_odom" default="true"/>
    <arg name="wait_imu_to_init" default="false"/>
    <!-- Sync/Visualization -->
    <arg name="approx_sync"              default="false"/>
    <arg name="approx_sync_max_interval" default="0.05"/>
    <arg name="topic_queue_size"         default="10"/>
    <arg name="queue_size"               default="10"/>
    <arg name="rtabmap_viz"              default="false"/>
    <arg name="rviz"                     default="false"/>
    <arg name="use_sim_time"             default="false"/>

    <arg name="visual_odometry"    default="false"/>
    <arg name="icp_odometry"       default="true"/>

    <!-- TEST -->
    <arg name="urdf_file" default="$(find-pkg-share g1_description)/urdf/g1_29_inspire.urdf"/>
    <node pkg="g1_bridge" exec="g1_bridge_node" name="g1_bridge_node" output="screen">
      <param from="$(find-pkg-share g1_bridge)/config/gains.yaml"/>
      <param name="simulator" value="false"/>
    </node>

    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(command 'cat $(var urdf_file)')"/>
    </node>

    <node pkg="tf2_ros" exec="static_transform_publisher" name="base_footprint_to_pelvis"
        args="--x 0 --y 0 --z 0.784202 --roll 0 --pitch 0 --yaw 0 --frame-id base_footprint --child-frame-id pelvis"/>

    <node pkg="tf2_ros" exec="static_transform_publisher" name="mid360_to_livox_frame"
        args="--x 0 --y 0 --z 0 --roll 3.141592653589793 --pitch 0 --yaw 0 --frame-id mid360_link --child-frame-id livox_frame"/>
    <!-- TEST -->

    <!-- Livox Driver -->
    <node pkg="livox_ros2" exec="livox_ros2_node" name="livox_lidar_publisher" output="screen">
        <param name="xfer_format" value="0"/>
        <param name="multi_topic" value="0"/>
        <param name="data_src" value="0"/>
        <param name="publish_freq" value="10.0"/>
        <param name="output_data_type" value="0"/>
        <param name="frame_id" value="livox_frame"/>
        <param name="user_config_path" value="$(find-pkg-share livox_ros2)/config/MID360_config.json"/>
    </node>

    <include file="$(find-pkg-share rtabmap_launch)/launch/rtabmap.launch.py">
        <!-- base + map -->
        <arg name="frame_id"     value="$(var frame_id)"/>
        <arg name="map_frame_id" value="$(var map_frame_id)"/>
        <arg name="odom_frame_id" value="$(var odom_frame_id)"/>
        <arg name="vo_frame_id" value="$(var vo_frame_id)"/>
        <arg name="publish_tf_odom" value="$(var publish_tf_odom)"/>
        <arg name="args" value="--Grid/MinGroundHeight -0.05 --Grid/MaxObstacleHeight 1.315"/>
        <!-- inputs -->
        <arg name="odom_topic" value="$(var odom_topic)"/>
        <arg name="depth" value="false"/>
        <arg name="subscribe_rgb" value="false"/>
        <arg name="subscribe_rgbd" value="false"/>
        <arg name="rgbd_sync" value="false"/>
        <!-- 3d LiDAR -->
        <arg name="subscribe_scan_cloud" value="true"/>
        <arg name="scan_cloud_topic"     value="$(var scan_cloud_topic)"/>
        <!-- imu -->
        <arg name="imu_topic"         value="$(var imu_topic)"/>
        <arg name="wait_imu_to_init"  value="$(var wait_imu_to_init)"/>
        <!-- sync / viz -->
        <arg name="approx_sync" value="$(var approx_sync)"/>
        <arg name="approx_sync_max_interval" value="$(var approx_sync_max_interval)"/>
        <arg name="topic_queue_size" value="$(var topic_queue_size)"/>
        <arg name="queue_size" value="$(var queue_size)"/>
        <arg name="rtabmap_viz" value="$(var rtabmap_viz)"/>
        <arg name="rviz" value="$(var rviz)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <!-- Odometry -->
        <arg name="visual_odometry" value="$(var visual_odometry)"/>
        <arg name="icp_odometry"    value="$(var icp_odometry)"/>
    </include>
</launch>
