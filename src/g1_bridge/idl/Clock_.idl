// toolchain; it is maintained by hand following the generated-header pattern.
// Kept for documentation of intent and field naming.

#include "builtin_interfaces/msg/Time.idl"

module rosgraph_msgs {
  module msg {
    module dds_ {
      struct Clock_ {
        ::builtin_interfaces::msg::dds_::Time_ clock;
      };
    };
  };
};
